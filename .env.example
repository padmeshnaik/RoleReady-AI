# Copy this file to .env and fill in values. Never commit .env.
# Streamlit can also read the same names from .streamlit/secrets.toml.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_INTERVIEWER=gpt-4o-mini
OPENAI_MODEL_SCORER=gpt-4o-mini
# Offline question-generation pipeline (not used by the live interview yet).
OPENAI_MODEL_QUESTION_GENERATOR=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional. Must match an existing Pinecone index (e.g. 1024). Leave unset to use
# the model's native size (1536 for text-embedding-3-small) when creating a new index.
# OPENAI_EMBEDDING_DIMENSIONS=1024

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=roleready-questions
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# App
SQLITE_PATH=data/roleready.db
INTERVIEW_QUESTION_COUNT=10
